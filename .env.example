# ==========================================================
# Copia este archivo como .env y completa los valores reales.
# El archivo .env NO se sube a git (está en .gitignore).
# ==========================================================

# --- Servidor ---
PORT=3000
# Cadena larga y aleatoria para firmar la sesión (express-session)
SESSION_SECRET=

# --- Credenciales de AWS ---
# Access Key del usuario IAM creado para la app (ver guía de la Fase 2).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Amazon Cognito (User Pool) ---
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Dominio del Hosted UI, ejemplo: https://techstore-xxxx.auth.us-east-1.amazoncognito.com
COGNITO_DOMAIN=
# URL a la que Cognito regresa después del login con Google
COGNITO_REDIRECT_URI=http://localhost:3000/auth/google/callback

# --- DynamoDB ---
DYNAMODB_TABLE=TechStoreProductos

# --- GitHub OAuth (Passport.js) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# --- JWT propio de la app (solo para usuarios que entran con GitHub) ---
APP_JWT_SECRET=

# --- Límites de intentos (contador visible en la app) ---
MAX_LOGIN_ATTEMPTS=5
MAX_MFA_ATTEMPTS=3
# Minutos que la app bloquea el login después de los 5 intentos fallidos
LOGIN_BLOQUEO_MINUTOS=15
